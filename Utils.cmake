include_guard(GLOBAL)

option(ARMONIK_COVERAGE "Instrument every target set up with setup_options() for code coverage (--coverage, GCC/Clang only)" OFF)
set(ARMONIK_SANITIZERS "AUTO" CACHE STRING
    "Sanitizers for every target set up with setup_options(): AUTO (address,undefined in Debug only, never on Alpine or MSVC), OFF, or a comma-separated list of address, undefined, leak, thread")
set_property(CACHE ARMONIK_SANITIZERS PROPERTY STRINGS AUTO OFF "address,undefined" address undefined leak thread "thread,undefined")

function(armonik_is_alpine out_var)
    set(result FALSE)
    if(EXISTS /etc/alpine-release)
        set(result TRUE)
    elseif(EXISTS /etc/issue)
        file(READ /etc/issue etc_issue_content)
        string(FIND "${etc_issue_content}" "Alpine" alpine_pos)
        if(NOT alpine_pos EQUAL -1)
            set(result TRUE)
        endif()
    endif()
    set(${out_var} ${result} PARENT_SCOPE)
endfunction()

# Computes the compile/link flags implied by ARMONIK_COVERAGE and ARMONIK_SANITIZERS.
# Fails the configuration on invalid or unsupported combinations.
function(armonik_instrumentation_flags compile_out link_out)
    set(flags)
    armonik_is_alpine(is_alpine)

    string(TOLOWER "${ARMONIK_SANITIZERS}" sanitizers)
    string(REPLACE " " "" sanitizers "${sanitizers}")
    if(sanitizers STREQUAL "auto")
        if(NOT MSVC AND NOT is_alpine)
            list(APPEND flags $<$<CONFIG:Debug>:-fsanitize=undefined,address>)
        endif()
    elseif(sanitizers STREQUAL "" OR sanitizers STREQUAL "off" OR sanitizers STREQUAL "none")
    else()
        string(REPLACE "," ";" sanitizer_list "${sanitizers}")
        list(REMOVE_DUPLICATES sanitizer_list)
        foreach(sanitizer IN LISTS sanitizer_list)
            if(NOT sanitizer MATCHES "^(address|undefined|leak|thread)$")
                message(FATAL_ERROR "ARMONIK_SANITIZERS: unknown sanitizer '${sanitizer}' in '${ARMONIK_SANITIZERS}'. "
                        "Use AUTO, OFF, or a comma-separated list of address, undefined, leak, thread.")
            endif()
        endforeach()
        if("thread" IN_LIST sanitizer_list AND ("address" IN_LIST sanitizer_list OR "leak" IN_LIST sanitizer_list))
            message(FATAL_ERROR "ARMONIK_SANITIZERS: 'thread' cannot be combined with 'address' or 'leak' (got '${ARMONIK_SANITIZERS}').")
        endif()
        if(MSVC)
            message(FATAL_ERROR "ARMONIK_SANITIZERS='${ARMONIK_SANITIZERS}' is only supported with GCC/Clang; use AUTO or OFF with MSVC.")
        endif()
        if(is_alpine)
            message(FATAL_ERROR "ARMONIK_SANITIZERS='${ARMONIK_SANITIZERS}' is not supported on Alpine (musl has no sanitizer runtimes); use AUTO or OFF.")
        endif()
        list(JOIN sanitizer_list "," sanitizer_joined)
        list(APPEND flags -fsanitize=${sanitizer_joined} -fno-omit-frame-pointer)
    endif()

    if(ARMONIK_COVERAGE)
        if(NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
            message(FATAL_ERROR "ARMONIK_COVERAGE requires GCC or Clang (current compiler: ${CMAKE_CXX_COMPILER_ID}).")
        endif()
        list(APPEND flags --coverage)
        if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
            # Keeps gcov counters consistent in multi-threaded code (ThreadPool, SessionService).
            list(APPEND flags -fprofile-update=atomic)
        endif()
    endif()

    set(${compile_out} ${flags} PARENT_SCOPE)
    set(${link_out} ${flags} PARENT_SCOPE)
endfunction()

function(armonik_report_instrumentation)
    armonik_instrumentation_flags(compile_flags link_flags)
    message(STATUS "ARMONIK_COVERAGE=${ARMONIK_COVERAGE} ARMONIK_SANITIZERS=${ARMONIK_SANITIZERS} -> instrumentation flags: ${compile_flags}")
    if(ARMONIK_COVERAGE AND NOT CMAKE_BUILD_TYPE STREQUAL "Debug")
        message(WARNING "ARMONIK_COVERAGE is ON with CMAKE_BUILD_TYPE='${CMAKE_BUILD_TYPE}'; use Debug for accurate line coverage.")
    endif()
endfunction()

function(setup_options project_name_param)

    if(${ARGC} GREATER 1)
        set(extra_param ${ARGV1})
    endif()

    armonik_instrumentation_flags(instrumentation_compile_flags instrumentation_link_flags)

    if(MSVC)
        target_compile_options(${project_name_param} PRIVATE /W4)
    else()
        armonik_is_alpine(is_alpine)
        target_compile_options(${project_name_param} PRIVATE -Wall -Wextra -Wpedantic -pedantic-errors ${instrumentation_compile_flags} ${extra_param})
        target_link_options(${project_name_param} PRIVATE ${instrumentation_link_flags})
        if(NOT is_alpine)
            target_link_options(${project_name_param} PRIVATE ${extra_param})
        endif()
    endif()

    set_property(TARGET ${project_name_param} PROPERTY CXX_STANDARD 11)
    set_property(TARGET ${project_name_param} PROPERTY CXX_STANDARD_REQUIRED ON)
    set_property(TARGET ${project_name_param} PROPERTY CXX_EXTENSIONS OFF)
endfunction()
function(split_version version_param)
    string(REGEX MATCHALL "[0-9]+" VERSION_LIST ${version_param})
    list(GET VERSION_LIST 0 VERSION_MAJOR)
    list(GET VERSION_LIST 1 VERSION_MINOR)
    list(GET VERSION_LIST 2 VERSION_PATCH)
endfunction()

function(setup_lib_version project_name_param)
    set_property(TARGET ${project_name_param} PROPERTY VERSION ${VERSION})
    set_property(TARGET ${project_name_param} PROPERTY SOVERSION ${VERSION_MAJOR})
    set_property(TARGET ${project_name_param} PROPERTY INTERFACE_${project_name_param}_MAJOR_VERSION ${VERSION_MAJOR})
    set_property(TARGET ${project_name_param} APPEND PROPERTY COMPATIBLE_INTERFACE_STRING ${project_name_param}_MAJOR_VERSION)
endfunction()
